{
  "name": "sail-suite-app",
  "version": "6.6.1",
  "description": "Sail-Suite: VoyagePlan, CourseCast, SailPilot and VoyageBook, four web apps for a sailing voyage.",
  "author": "Sepp",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "homepage": "https://sail-suite.app",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,css}\""
  },
  "dependencies": {
    "@diffusionstudio/vits-web": "^1.0.3",
    "@neaps/tide-predictor": "0.11.0",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vite": "^7.3.8"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
